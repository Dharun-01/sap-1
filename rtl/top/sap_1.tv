/* Format: 
_reset(1)
_enClk(1)
_manAddrModeSwitch(1)
_manDataModeSwitch(1)
_manRamInControlLine(1)
_manRamIn(1)
_manAddress(4)
_manData(8)
_outViewBus(8) */

// WORD_LENGTH: 26

                               // || !-- RESET PHASE --!
    
  1_0_0_0_0_0_0000_00000000_zzzzzzzz
  0_0_0_0_0_0_0000_00000000_zzzz0000

                           // || !-- MANUAL PROGRAMMING PHASE --!
// PROGRAM FOR COUNTDOWN 
  0_0_1_1_1_0_0000_00001111_zzzz0000 // ADDR:0 -> LDA 15(1111)
  0_0_1_1_1_1_0000_00001111_zzzz0000
  0_0_1_1_1_0_0000_00001111_zzzz0000

  0_0_1_1_1_0_0001_10000000_zzzz0000 // ADDR:1 -> OUT 0000
  0_0_1_1_1_1_0001_10000000_zzzz0000
  0_0_1_1_1_0_0001_10000000_zzzz0000

  0_0_1_1_1_0_0010_00111110_zzzz0000 // ADDR:2 -> SUB 14(0111)
  0_0_1_1_1_1_0010_00111110_zzzz0000
  0_0_1_1_1_0_0010_00111110_zzzz0000

  0_0_1_1_1_0_0011_01110110_zzzz0000 // ADDR:3 -> JZ 6(0110)
  0_0_1_1_1_1_0011_01110110_zzzz0000
  0_0_1_1_1_0_0011_01110110_zzzz0000

  0_0_1_1_1_0_0100_01001111_zzzz0000 // ADDR:4 -> STA 15(1111)
  0_0_1_1_1_1_0100_01001111_zzzz0000
  0_0_1_1_1_0_0100_01001111_zzzz0000

  0_0_1_1_1_0_0101_01010001_zzzz0000 // ADDR:5 -> JMP 1
  0_0_1_1_1_1_0101_01010001_zzzz0000
  0_0_1_1_1_0_0101_01010001_zzzz0000

  0_0_1_1_1_0_0110_10010000_zzzz0000 // ADDR:6 -> HLT 0000
  0_0_1_1_1_1_0110_10010000_zzzz0000
  0_0_1_1_1_0_0110_10010000_zzzz0000
  
  0_0_1_1_1_0_1110_00000001_zzzz0000  // Addr 14: Constant (1)
  0_0_1_1_1_1_1110_00000001_zzzz0000
  0_0_1_1_1_0_1110_00000001_zzzz0000
  
  0_0_1_1_1_0_1111_00001111_zzzz0000  // Addr 15: Initial Countdown Variable (15)
  0_0_1_1_1_1_1111_00001111_zzzz0000
  0_0_1_1_1_0_1111_00001111_zzzz0000

                            // || !-- AUTOMATIC EXECUTION PHASE --!
  0_1_0_0_0_0_0000_00000000_11111111  // Special end-marker vector to switch into free-run
