// Format: manual_addr(4)_manual_data(8)_addr(4)_data(8)_controls(5)_expected_y(8)
// Controls: en_addr_mode, en_data_mode, ram_in_control_line, en_manual_ram_in, en_ram_in

// --- PHASE 1: MANUAL PROGRAMMER MODE (Loading Instructions) ---
// Write 8'hA5 (10100101) to Address 4'h0 manually
0000_10100101_1111_11111111_11110_ZZZZZZZZ
// Write 8'h3C (00111100) to Address 4'hF manually
1111_00111100_1111_11111111_11110_ZZZZZZZZ

// Read back Address 4'h0 manually (expecting 8'hA5)
0000_11111111_1111_11111111_10000_10100101
// Read back Address 4'hF manually (expecting 8'h3C)
1111_11111111_1111_11111111_10000_00111100

// --- PHASE 2: COMPUTER CONTROL UNIT MODE (Running Instructions) ---
// Write 8'hFF (11111111) to Address 4'h2 via Bus Control
1111_11111111_0010_11111111_00001_ZZZZZZZZ

// Read back Address 4'h2 via Bus Control (expecting 8'hFF)
1111_11111111_0010_00000000_00000_11111111

// --- PHASE 3: HIGH IMPEDANCE CHECK ---
// Read Address 4'h2 but turn off en_ram_out (expecting Float/Z)
1111_11111111_0010_00000000_00000_ZZZZZZZZ