// Format: opcode(4)_reset(1)_step(3)_flag(2)_control_lines(16)
// Control Lines: [15]en_ir_out, [14]en_ir_in, [13]en_ras_in, [12]en_a_in, [11]en_ram_out, [10]en_a_out, [9]en_b_in, [8]en_pc_in, [7]en_pc_out, [6]en_ram_in, [5]en_add_sub, [4]en_hlt, [3]en_alu_out, [2]en_out_in, [1]en_pc_latcher, [0]en_reset_step_counter

// ==========================================
// 0. RESET TIMING CASES
// ==========================================
// Even if opcode is ADD at T0, if reset=1, all outputs must be 0
0010_1_000_00_0000_0000_0000_0000

// ==========================================
// 1. LDA INSTRUCTION (Load Accumulator)
// ==========================================
0000_0_000_00_0010_0000_1000_0000 // T0: en_pc_out=1, en_ras_in=1
0000_0_001_00_0100_1000_0000_0010 // T1: en_ram_out=1, en_ir_in=1, en_pc_latcher=1
0000_0_010_00_1010_0000_0000_0000 // T2: en_ir_out=1, en_ras_in=1
0000_0_011_00_0001_1000_0000_0001 // T3: en_ram_out=1, en_a_in=1, en_reset_step_counter=1

// ==========================================
// 2. LDI INSTRUCTION (Load Immediate)
// ==========================================
0001_0_000_00_0010_0000_1000_0000 // T0: Fetch
0001_0_001_00_0100_1000_0000_0010 // T1: Fetch
0001_0_010_00_1001_0000_0000_0001 // T2: en_ir_out=1, en_a_in=1, en_reset_step_counter=1

// ==========================================
// 3. ADD INSTRUCTION
// ==========================================
0010_0_000_00_0010_0000_1000_0000 // T0: Fetch
0010_0_001_00_0100_1000_0000_0010 // T1: Fetch
0010_0_010_00_1010_0000_0000_0000 // T2: en_ir_out=1, en_ras_in=1
0010_0_011_00_0000_1010_0000_0000 // T3: en_ram_out=1, en_b_in=1
0010_0_100_00_0001_0000_0000_1001 // T4: en_alu_out=1, en_a_in=1, en_reset_step_counter=1

// ==========================================
// 4. SUB INSTRUCTION
// ==========================================
0011_0_000_00_0010_0000_1000_0000 // T0: Fetch
0011_0_001_00_0100_1000_0000_0010 // T1: Fetch
0011_0_010_00_1010_0000_0000_0000 // T2: en_ir_out=1, en_ras_in=1
0011_0_011_00_0000_1010_0000_0000 // T3: en_ram_out=1, en_b_in=1
0011_0_100_00_0001_0000_0010_1001 // T4: en_alu_out=1, en_a_in=1, en_add_sub=1, en_reset_step_counter=1

// ==========================================
// 5. STA INSTRUCTION (Store Accumulator)
// ==========================================
0100_0_000_00_0010_0000_1000_0000 // T0: Fetch
0100_0_001_00_0100_1000_0000_0010 // T1: Fetch
0100_0_010_00_1010_0000_0000_0000 // T2: en_ir_out=1, en_ras_in=1
0100_0_011_00_0000_0100_0100_0001 // T3: en_a_out=1, en_ram_in=1, en_reset_step_counter=1

// ==========================================
// 6. JMP INSTRUCTION (Unconditional Jump)
// ==========================================
0101_0_000_00_0010_0000_1000_0000 // T0: Fetch
0101_0_001_00_0100_1000_0000_0010 // T1: Fetch
0101_0_010_00_1000_0001_0000_0011 // T2: en_ir_out=1, en_pc_in=1, en_pc_latcher=1, en_reset_step_counter=1

// ==========================================
// 7. JC INSTRUCTION (Jump if Carry)
// ==========================================
// Case A: Carry Flag is FALSE (flag[1] = 0) -> Act as NOP, reset step counter
0110_0_010_00_0000_0000_0000_0001 
// Case B: Carry Flag is TRUE (flag[1] = 1) -> Execute Jump Micro-Ops
0110_0_010_10_1000_0001_0000_0011 

// ==========================================
// 8. JZ INSTRUCTION (Jump if Zero)
// ==========================================
// Case A: Zero Flag is FALSE (flag[0] = 0) -> Act as NOP, reset step counter
0111_0_010_00_0000_0000_0000_0001 
// Case B: Zero Flag is TRUE (flag[0] = 1) -> Execute Jump Micro-Ops
0111_0_010_01_1000_0001_0000_0011 

// ==========================================
// 9. OUT INSTRUCTION (Output Register)
// ==========================================
1000_0_000_00_0010_0000_1000_0000 // T0: Fetch
1000_0_001_00_0100_1000_0000_0010 // T1: Fetch
1000_0_010_00_0000_0100_0000_0101 // T2: en_a_out=1, en_out_in=1, en_reset_step_counter=1

// ==========================================
// 10. HLT INSTRUCTION (Halt Execution)
// ==========================================
1001_0_000_00_0010_0000_1000_0000 // T0: Fetch
1001_0_001_00_0100_1000_0000_0010 // T1: Fetch
1001_0_010_00_0000_0000_0001_0000 // T2: en_hlt=1

// ==========================================
// 11. INVALID OPCODE PROTECTION CASE
// ==========================================
// Unmapped Opcode (e.g., 4'b1111) should stay safe, no floating lines
1111_0_010_00_0000_0000_0000_0000