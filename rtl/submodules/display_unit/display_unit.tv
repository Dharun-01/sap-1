// Format: reset_sig(1)_data(8)_en_out_in(1)_control_lines(14)

// !-- DIGIT - 0 WHEN ENABLE = 1 --!
0_00000000_1_1111110_1111110

// !-- DIGIT - 1 WHEN ENABLE = 0 --!
0_00000001_0_1111110_1111110

// !-- DIGIT - 2 WHEN ENABLE = 1 --!
0_00000010_1_1111110_1101101

// !-- DIGIT - 9 WHEN ENABLE = 1 --!
0_00001001_1_1111110_1111011 

// !--TEST TRANSITION OF TWO SEVEN SEGMENT DISPLAY AT THE SAME TIME
0_00001001_1_1111110_1111011 // 09 (Tens=0, Ones=9)
0_00001010_1_0000110_1111110 // 10 (Tens=1, Ones=0)

//  !-- ABSOLUTE HIGHEST VALUE TEST --!
0_01100011_1_1111011_1111011 // 99 (Tens=9, Ones=9)

// !-- OVERFLOW OF DIGIT --! 
0_01100100_1_0000000_1111110 // 100 -> (Tens=Blank, Ones=0)

// !-- ABSOLUTE MAXIMUM OF 8 BIT BUS --!
0_11111111_1_0000000_1011011 // 255 -> (Tens=Blank, Ones=Blank)

// !-- CHECK RESET FLAG --!
1_00011001_0_0000000_0000000
