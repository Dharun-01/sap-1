$var parameter 32 #> W $end
$var reg 2 $> tb_a [1:0] $end
$scope module dut $end
$var wire 2 %> a [1:0] $end
$var wire 1 "> y $end
$var parameter 32 &> WIDTH $end
$upscope $end
$upscope $end
$scope module xor_n_tb $end
$var wire 1 '> tb_y $end
$var parameter 32 (> W $end
$var reg 2 )> tb_a [1:0] $end
$scope module dut $end
$var wire 2 *> a [1:0] $end
$var wire 1 '> y $end
$var parameter 32 +> WIDTH $end
$upscope $end
$upscope $end
$enddefinitions $end
